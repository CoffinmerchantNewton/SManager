{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smanager.local/contracts/diagnosis_analysis.schema.json",
  "title": "Diagnosis Analysis",
  "type": "object",
  "required": ["version", "run_id", "summary", "recommendations"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "run_id": { "type": "string" },
    "summary": {
      "type": "object",
      "required": ["finding_count", "risk_level", "auto_retry_allowed", "requires_operator"],
      "properties": {
        "finding_count": { "type": "integer", "minimum": 0 },
        "risk_level": { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] },
        "auto_retry_allowed": { "type": "boolean" },
        "requires_operator": { "type": "boolean" },
        "recommended_next_action": { "type": ["string", "null"] }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_code", "severity", "category", "action", "auto_allowed", "reason"],
        "properties": {
          "finding_code": { "type": "string" },
          "node": { "type": ["string", "null"] },
          "severity": { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] },
          "category": { "type": "string" },
          "action": { "type": "string" },
          "auto_allowed": { "type": "boolean" },
          "reason": { "type": "string" },
          "cli": { "type": ["string", "null"] },
          "retry_after_action": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
