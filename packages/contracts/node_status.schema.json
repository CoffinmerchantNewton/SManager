{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smanager.local/contracts/node_status.schema.json",
  "title": "Forecast Node Status",
  "type": "object",
  "required": ["run_id", "node", "status", "progress", "attempt", "updated_at"],
  "properties": {
    "run_id": { "type": "string" },
    "node": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["pending", "ready", "running", "success", "error", "skipped", "retrying", "cancelled"]
    },
    "progress": { "type": "number", "minimum": 0, "maximum": 100 },
    "attempt": { "type": "integer", "minimum": 0 },
    "slurm_job_id": { "type": ["string", "null"] },
    "started_at": { "type": ["string", "null"] },
    "updated_at": { "type": "string" },
    "finished_at": { "type": ["string", "null"] },
    "error_code": { "type": ["string", "null"] },
    "message": { "type": "string" },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "log_files": { "type": "array", "items": { "type": "string" } }
  }
}
