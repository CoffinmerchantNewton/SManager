{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smanager.local/contracts/workflow_status.schema.json",
  "title": "Forecast Workflow Status",
  "type": "object",
  "required": ["run_id", "status", "progress", "updated_at", "nodes", "run_spec_path"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["pending", "ready", "running", "success", "error", "retrying", "cancelled"]
    },
    "progress": { "type": "number", "minimum": 0, "maximum": 100 },
    "updated_at": { "type": "string" },
    "nodes": {
      "type": "array",
      "items": { "$ref": "node_status.schema.json" }
    },
    "run_spec_path": { "type": "string" }
  }
}
