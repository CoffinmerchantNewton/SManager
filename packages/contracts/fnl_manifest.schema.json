{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smanager.local/contracts/fnl_manifest.schema.json",
  "title": "FNL Manifest",
  "type": "object",
  "required": ["provider", "start", "end", "ok", "files", "checked_at"],
  "properties": {
    "provider": { "type": "string", "const": "FNL" },
    "start": { "type": "string" },
    "end": { "type": "string" },
    "roots": { "type": "array", "items": { "type": "string" } },
    "min_bytes": { "type": "integer" },
    "ok": { "type": "boolean" },
    "checked_at": { "type": "string" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["valid_time", "file_name", "status", "needs_repair", "valid_grib", "checked_at"],
        "properties": {
          "valid_time": { "type": "string" },
          "file_name": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["server_ok", "missing", "bad_magic", "too_small", "link_broken", "downloaded", "uploaded", "verified"]
          },
          "needs_repair": { "type": "boolean" },
          "source": {
            "type": ["string", "null"],
            "enum": ["server_primary", "server_fallback", "jumpbox_download", null]
          },
          "server_path": { "type": ["string", "null"] },
          "local_path": { "type": ["string", "null"] },
          "size_bytes": { "type": ["integer", "null"] },
          "valid_grib": { "type": "boolean" },
          "checked_at": { "type": "string" }
        }
      }
    }
  }
}
