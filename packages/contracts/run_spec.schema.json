{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smanager.local/contracts/run_spec.schema.json",
  "title": "Forecast Run Spec",
  "type": "object",
  "required": ["version", "run_id", "start", "end", "period", "domain", "variant", "met_provider", "nodes"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "start": { "type": "string", "description": "YYYYMMDDHH or YYYYMMDD" },
    "end": { "type": "string", "description": "YYYYMMDDHH or YYYYMMDD" },
    "period": { "type": "string", "enum": ["spring", "summer", "autumn"] },
    "domain": { "type": "string" },
    "variant": { "type": "string" },
    "met_provider": { "type": "string" },
    "created_at": { "type": "string" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "command": { "type": ["string", "null"] },
          "cwd": { "type": ["string", "null"] },
          "env": { "type": "object", "additionalProperties": { "type": "string" } },
          "slurm": { "type": "object" }
        }
      }
    }
  }
}
