{
  "env": {
    "FLOWCTL": "/g7/anxq/Zhangjt/workspace/Smanager/auto-pollen-flow/flowctl.py",
    "FLOW_BIN": "/g7/anxq/Zhangjt/workspace/Smanager/auto-wrfchem-pollen/bin",
    "ENV_SCRIPT": "/g7/anxq/Zhangjt/workspace/load_env.sh",
    "PYTHON_BIN": "/g7/anxq/Zhangjt/softwares/miniconda3/envs/wrfTool/bin/python",
    "FNL_ROOTS": "/g1/COMMONDATA/glob/fnl",
    "FNL_MIN_MB": "5",
    "PRODUCT_SOURCE_GLOB": "$FLOW_RUN_DIR/wrfout/wrfout_d01_*:$FLOW_RUN_DIR/wrfchemi/*.nc:$FLOW_RUN_DIR/pollen_flux/*.nc",
    "PRODUCT_COPY_SOURCES": "false",
    "PRODUCT_SUMMARY_PRESET": "wrf_pollen",
    "PRODUCT_SUMMARY_PRIMARY_VARIABLE": "E_POLLEN",
    "PRODUCT_SUMMARY_MAX_STEPS": "9",
    "PRODUCT_SUMMARY_EVERY_NTH": "24"
  },
  "slurm_defaults": {
    "partition": "serial",
    "nodes": 1,
    "ntasks": 1,
    "cpus_per_task": 1,
    "walltime": "01:00:00"
  },
  "nodes": {
    "fnl_verify": {
      "command": "\"$PYTHON_BIN\" \"$FLOWCTL\" fnl-verify --run-id \"$RUN_ID\"",
      "slurm": {
        "walltime": "00:20:00"
      }
    },
    "wps_geogrid": {
      "command": "RUN_DIR=\"$FLOW_RUN_DIR\" bash \"$FLOW_BIN/setup_case.sh\"",
      "env": {
        "WPS_GEOGRID_COMMAND": "setup_case"
      },
      "slurm": {
        "walltime": "01:00:00"
      }
    },
    "wps_ungrib": {
      "command": "RUN_DIR=\"$FLOW_RUN_DIR\" START_DATE=20250815 PREDICT_DAYS=7 bash \"$FLOW_BIN/run_wps_met_fnl.sh\"",
      "env": {
        "WPS_UNGRIB_COMMAND": "run_wps_met_fnl"
      },
      "slurm": {
        "walltime": "03:00:00"
      }
    },
    "wps_metgrid": {
      "command": "test -s \"$FLOW_RUN_DIR/met_em_dir.txt\" && test -n \"$(find \"$FLOW_RUN_DIR/met_em\" -maxdepth 1 -name 'met_em.d01.*' -print -quit)\"",
      "env": {
        "WPS_METGRID_COMMAND": "verify_met_em"
      },
      "slurm": {
        "walltime": "00:10:00"
      }
    },
    "wrf_setup": {
      "command": "test -x \"$FLOW_RUN_DIR/WRF/real.exe\" && test -x \"$FLOW_RUN_DIR/WRF/wrf.exe\"",
      "env": {
        "WRF_SETUP_COMMAND": "verify_wrf_template"
      },
      "slurm": {
        "walltime": "00:10:00"
      }
    },
    "real": {
      "command": "RUN_DIR=\"$FLOW_RUN_DIR\" WRF_DIR=\"$FLOW_RUN_DIR/WRF\" MET_DIR=\"$FLOW_RUN_DIR/met_em\" START_DATE=20250815 PREDICT_DAYS=7 bash \"$FLOW_BIN/run_real.sh\"",
      "env": {
        "REAL_COMMAND": "run_real"
      },
      "slurm": {
        "walltime": "01:00:00"
      }
    },
    "compute_gdd": {
      "command": "RUN_DIR=\"$FLOW_RUN_DIR\" CASE_WRF_DIR=\"$FLOW_RUN_DIR/WRF\" START_DATE=20250815 PREDICT_DAYS=7 bash \"$FLOW_BIN/run_wrfchemi_chain.sh\"",
      "env": {
        "COMPUTE_GDD_COMMAND": "run_wrfchemi_chain"
      },
      "slurm": {
        "partition": "normal",
        "ntasks": 8,
        "cpus_per_task": 1,
        "walltime": "08:00:00"
      }
    },
    "prep_pollen": {
      "command": "test -n \"$(find \"$FLOW_RUN_DIR/wrfchemi\" -maxdepth 1 -name 'wrfchemi_d01_*.nc' -print -quit)\"",
      "env": {
        "PREP_POLLEN_COMMAND": "verify_wrfchemi"
      },
      "slurm": {
        "walltime": "00:10:00"
      }
    },
    "wrf_run": {
      "command": "RUN_DIR=\"$FLOW_RUN_DIR\" WRF_DIR=\"$FLOW_RUN_DIR/WRF\" WRFCHEMI_DIR=\"$FLOW_RUN_DIR/wrfchemi\" START_DATE=20250815 PREDICT_DAYS=7 JOB_NAME=WRFNEW15 NTASKS=576 bash \"$FLOW_BIN/submit_wrfchem.sh\"",
      "env": {
        "WRF_RUN_COMMAND": "submit_wrfchem"
      },
      "slurm": {
        "walltime": "00:20:00"
      }
    },
    "postprocess_eval": {
      "command": "RUN_DIR=\"$FLOW_RUN_DIR\" WRF_DIR=\"$FLOW_RUN_DIR/WRF\" bash \"$FLOW_BIN/wait_wrfchem.sh\"",
      "env": {
        "POSTPROCESS_EVAL_COMMAND": "wait_wrfchem"
      },
      "slurm": {
        "walltime": "12:00:00"
      }
    },
    "product_extract": {
      "command": "bash \"/g7/anxq/Zhangjt/workspace/Smanager/auto-pollen-flow/node_commands/product_extract.sh\"",
      "slurm": {
        "walltime": "01:00:00"
      }
    },
    "package_products": {
      "command": "bash \"/g7/anxq/Zhangjt/workspace/Smanager/auto-pollen-flow/node_commands/package_products.sh\"",
      "slurm": {
        "walltime": "00:20:00"
      }
    }
  }
}
