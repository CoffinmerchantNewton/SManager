{
  "env": {
    "FLOWCTL": "/g7/anxq/Zhangjt/workspace/auto-pollen-flow/flowctl.py",
    "NODE_COMMAND_DIR": "/g7/anxq/Zhangjt/workspace/auto-pollen-flow/node_commands",
    "AUTO_POLLEN_ROOT": "/g7/anxq/Zhangjt/workspace/auto-pollen",
    "ENV_SCRIPT": "/g7/anxq/Zhangjt/workspace/load_env.sh",
    "PYTHON_BIN": "python3",
    "WPS_WORK_DIR": "/g7/anxq/Zhangjt/workspace/WPS",
    "WRF_RUN_DIR": "/g7/anxq/Zhangjt/workspace/wrf-runs/current",
    "PRODUCT_SUMMARY_PRESET": "wrf_pollen",
    "PRODUCT_SUMMARY_VARIABLES": "",
    "PRODUCT_SUMMARY_VARIABLE": "",
    "PRODUCT_SUMMARY_PRIMARY_VARIABLE": "pollen_total",
    "PRODUCT_SUMMARY_MAX_STEPS": "7",
    "PRODUCT_SUMMARY_EVERY_NTH": "1",
    "PRODUCT_COPY_SOURCES": "false",
    "PRODUCT_GEOJSON_VARIABLE": "pollen_total",
    "PRODUCT_PNG_VARIABLE": "pollen_total",
    "PRODUCT_PNG_OPACITY": "0.72"
  },
  "slurm_defaults": {
    "partition": "normal",
    "nodes": 1,
    "ntasks": 1,
    "cpus_per_task": 4
  },
  "nodes": {
    "fnl_verify": {
      "command": "python3 \"$FLOWCTL\" fnl-verify --run-id \"$RUN_ID\""
    },
    "wps_geogrid": {
      "command": "bash \"$NODE_COMMAND_DIR/wps_geogrid.sh\"",
      "env": {
        "WPS_GEOGRID_COMMAND": "./geogrid.exe"
      }
    },
    "wps_ungrib": {
      "command": "bash \"$NODE_COMMAND_DIR/wps_ungrib.sh\"",
      "env": {
        "WPS_UNGRIB_COMMAND": "./link_grib.csh /g1/COMMONDATA/glob/fnl/fnl_* && ./ungrib.exe"
      }
    },
    "wps_metgrid": {
      "command": "bash \"$NODE_COMMAND_DIR/wps_metgrid.sh\"",
      "env": {
        "WPS_METGRID_COMMAND": "./metgrid.exe"
      }
    },
    "wrf_setup": {
      "command": "bash \"$NODE_COMMAND_DIR/wrf_setup.sh\"",
      "env": {
        "WRF_SETUP_COMMAND": "bash \"$AUTO_POLLEN_ROOT/scripts/setup_wrf_run.sh\""
      }
    },
    "real": {
      "command": "bash \"$NODE_COMMAND_DIR/real.sh\"",
      "env": {
        "REAL_CWD": "/g7/anxq/Zhangjt/workspace/wrf-runs/current",
        "REAL_COMMAND": "mpirun -np 64 ./real.exe"
      },
      "slurm": {
        "cpus_per_task": 8
      }
    },
    "compute_gdd": {
      "command": "bash \"$NODE_COMMAND_DIR/compute_gdd.sh\"",
      "env": {
        "COMPUTE_GDD_COMMAND": "python3 \"$AUTO_POLLEN_ROOT/compute_gdd.py\""
      }
    },
    "prep_pollen": {
      "command": "bash \"$NODE_COMMAND_DIR/prep_pollen.sh\"",
      "env": {
        "PREP_POLLEN_COMMAND": "python3 \"$AUTO_POLLEN_ROOT/prep_pollen_data.py\""
      }
    },
    "wrf_run": {
      "command": "bash \"$NODE_COMMAND_DIR/wrf_run.sh\"",
      "env": {
        "WRF_RUN_CWD": "/g7/anxq/Zhangjt/workspace/wrf-runs/current",
        "WRF_RUN_COMMAND": "mpirun -np 64 ./wrf.exe"
      },
      "slurm": {
        "nodes": 2,
        "ntasks": 64,
        "cpus_per_task": 1
      }
    },
    "postprocess_eval": {
      "command": "bash \"$NODE_COMMAND_DIR/postprocess_eval.sh\"",
      "env": {
        "POSTPROCESS_EVAL_COMMAND": "python3 \"$AUTO_POLLEN_ROOT/batch_eval_pollen.py\""
      }
    },
    "product_extract": {
      "command": "bash \"$NODE_COMMAND_DIR/product_extract.sh\""
    },
    "package_products": {
      "command": "bash \"$NODE_COMMAND_DIR/package_products.sh\""
    }
  }
}
