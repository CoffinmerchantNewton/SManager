{
  "env": {
    "FLOWCTL": "/g7/anxq/Zhangjt/workspace/auto-pollen-flow/flowctl.py",
    "NODE_COMMAND_DIR": "/g7/anxq/Zhangjt/workspace/auto-pollen-flow/node_commands",
    "AUTO_POLLEN_ROOT": "/g7/anxq/Zhangjt/workspace/auto-pollen",
    "ENV_SCRIPT": "/g7/anxq/Zhangjt/workspace/load_env.sh",
    "PYTHON_BIN": "python3",
    "PRODUCT_GEOJSON_VARIABLE": "",
    "PRODUCT_PNG_VARIABLE": "",
    "PRODUCT_PNG_OPACITY": "0.72"
  },
  "slurm_defaults": {
    "partition": "normal",
    "nodes": 1,
    "ntasks": 1,
    "cpus_per_task": 4
  },
  "nodes": {
    "fnl_verify": {
      "command": "python3 \"$FLOWCTL\" fnl-verify --run-id \"$RUN_ID\""
    },
    "wps_geogrid": {
      "command": "bash \"$NODE_COMMAND_DIR/wps_geogrid.sh\""
    },
    "wps_ungrib": {
      "command": "bash \"$NODE_COMMAND_DIR/wps_ungrib.sh\""
    },
    "wps_metgrid": {
      "command": "bash \"$NODE_COMMAND_DIR/wps_metgrid.sh\""
    },
    "wrf_setup": {
      "command": "bash \"$NODE_COMMAND_DIR/wrf_setup.sh\""
    },
    "real": {
      "command": "bash \"$NODE_COMMAND_DIR/real.sh\"",
      "slurm": {
        "cpus_per_task": 8
      }
    },
    "compute_gdd": {
      "command": "bash \"$NODE_COMMAND_DIR/compute_gdd.sh\""
    },
    "prep_pollen": {
      "command": "bash \"$NODE_COMMAND_DIR/prep_pollen.sh\""
    },
    "wrf_run": {
      "command": "bash \"$NODE_COMMAND_DIR/wrf_run.sh\"",
      "slurm": {
        "nodes": 2,
        "ntasks": 64,
        "cpus_per_task": 1
      }
    },
    "postprocess_eval": {
      "command": "bash \"$NODE_COMMAND_DIR/postprocess_eval.sh\""
    },
    "product_extract": {
      "command": "bash \"$NODE_COMMAND_DIR/product_extract.sh\""
    },
    "package_products": {
      "command": "bash \"$NODE_COMMAND_DIR/package_products.sh\""
    }
  }
}
