{
  "env": {
    "FLOWCTL": "/g7/anxq/Zhangjt/workspace/Smanager/auto-pollen-flow/flowctl.py",
    "NODE_COMMAND_DIR": "/g7/anxq/Zhangjt/workspace/Smanager/auto-pollen-flow/templates/node_commands",
    "AUTO_POLLEN_ROOT": "/g7/anxq/Zhangjt/workspace/auto-pollen",
    "AUTO_POLLEN_TEMPLATE_DIR": "/g7/anxq/Zhangjt/workspace/auto-pollen/template",
    "ENV_SCRIPT": "/g7/anxq/Zhangjt/workspace/auto-pollen/load_env.sh",
    "PYTHON_BIN": "/g7/anxq/Zhangjt/softwares/miniconda3/envs/wrfTool/bin/python",
    "WPS_WORK_DIR": "/g7/anxq/Zhangjt/workspace/auto-pollen/WPS",
    "WRF_RUN_DIR": "/g7/anxq/Zhangjt/workspace/auto-pollen/run",
    "FNL_ROOTS": "/g1/COMMONDATA/glob/fnl:/g7/anxq/Zhangjt/static/fnl",
    "FNL_MIN_MB": "5",
    "PRODUCT_SUMMARY_PRESET": "wrf_pollen",
    "PRODUCT_SUMMARY_PRIMARY_VARIABLE": "pollen_total",
    "PRODUCT_SUMMARY_MAX_STEPS": "7",
    "PRODUCT_SUMMARY_EVERY_NTH": "1",
    "PRODUCT_COPY_SOURCES": "false",
    "PRODUCT_GEOJSON_VARIABLE": "pollen_total",
    "PRODUCT_CONTOUR_VARIABLE": "pollen_total",
    "PRODUCT_GEOTIFF_VARIABLE": "pollen_total",
    "PRODUCT_PNG_VARIABLE": "pollen_total",
    "PRODUCT_PNG_OPACITY": "0.72",
    "PRODUCT_CITY_FORECAST_ENABLED": "true",
    "PRODUCT_CITY_POINTS_FILE": "/g7/anxq/Zhangjt/workspace/Smanager/auto-pollen-flow/templates/run_spec/stations.china_pollen.json",
    "PRODUCT_POLLEN_RISK_THRESHOLDS": "300,600,1000"
  },
  "slurm_defaults": {
    "partition": "normal",
    "nodes": 1,
    "ntasks": 1,
    "cpus_per_task": 4,
    "walltime": "02:00:00"
  },
  "nodes": {
    "fnl_verify": {
      "command": "python3 \"$FLOWCTL\" fnl-verify --run-id \"$RUN_ID\""
    },
    "wps_geogrid": {
      "command": "bash \"$NODE_COMMAND_DIR/wps_geogrid.sh\"",
      "env": {
        "WPS_GEOGRID_COMMAND": "./geogrid.exe",
        "WPS_GEOGRID_CWD": "/g7/anxq/Zhangjt/workspace/auto-pollen/WPS"
      },
      "slurm": {
        "walltime": "00:30:00"
      }
    },
    "wps_ungrib": {
      "command": "bash \"$NODE_COMMAND_DIR/wps_ungrib.sh\"",
      "env": {
        "WPS_UNGRIB_COMMAND": "./link_grib.csh /g1/COMMONDATA/glob/fnl/fnl_* /g7/anxq/Zhangjt/static/fnl/fnl_* && ./ungrib.exe",
        "WPS_UNGRIB_CWD": "/g7/anxq/Zhangjt/workspace/auto-pollen/WPS"
      },
      "slurm": {
        "walltime": "01:00:00"
      }
    },
    "wps_metgrid": {
      "command": "bash \"$NODE_COMMAND_DIR/wps_metgrid.sh\"",
      "env": {
        "WPS_METGRID_COMMAND": "./metgrid.exe",
        "WPS_METGRID_CWD": "/g7/anxq/Zhangjt/workspace/auto-pollen/WPS"
      },
      "slurm": {
        "walltime": "01:00:00"
      }
    },
    "wrf_setup": {
      "command": "bash \"$NODE_COMMAND_DIR/wrf_setup.sh\"",
      "env": {
        "WRF_SETUP_COMMAND": "bash \"$AUTO_POLLEN_ROOT/scripts/setup_wrf_run.sh\" \"$AUTO_POLLEN_TEMPLATE_DIR\" \"$FLOW_RUN_DIR\"",
        "WRF_SETUP_CWD": "/g7/anxq/Zhangjt/workspace/auto-pollen"
      },
      "slurm": {
        "walltime": "00:30:00"
      }
    },
    "real": {
      "command": "bash \"$NODE_COMMAND_DIR/real.sh\"",
      "env": {
        "REAL_CWD": "/g7/anxq/Zhangjt/workspace/auto-pollen/run",
        "REAL_COMMAND": "mpirun -np 64 ./real.exe"
      },
      "slurm": {
        "nodes": 1,
        "ntasks": 64,
        "cpus_per_task": 1,
        "walltime": "02:00:00"
      }
    },
    "compute_gdd": {
      "command": "bash \"$NODE_COMMAND_DIR/compute_gdd.sh\"",
      "env": {
        "COMPUTE_GDD_COMMAND": "python3 \"$AUTO_POLLEN_ROOT/compute_gdd.py\"",
        "COMPUTE_GDD_CWD": "/g7/anxq/Zhangjt/workspace/auto-pollen"
      },
      "slurm": {
        "walltime": "00:30:00"
      }
    },
    "prep_pollen": {
      "command": "bash \"$NODE_COMMAND_DIR/prep_pollen.sh\"",
      "env": {
        "PREP_POLLEN_COMMAND": "python3 \"$AUTO_POLLEN_ROOT/prep_pollen_data.py\"",
        "PREP_POLLEN_CWD": "/g7/anxq/Zhangjt/workspace/auto-pollen"
      },
      "slurm": {
        "walltime": "01:00:00"
      }
    },
    "wrf_run": {
      "command": "bash \"$NODE_COMMAND_DIR/wrf_run.sh\"",
      "env": {
        "WRF_RUN_CWD": "/g7/anxq/Zhangjt/workspace/auto-pollen/run",
        "WRF_RUN_COMMAND": "mpirun -np 64 ./wrf.exe"
      },
      "slurm": {
        "nodes": 2,
        "ntasks": 64,
        "cpus_per_task": 1,
        "walltime": "48:00:00"
      }
    },
    "postprocess_eval": {
      "command": "bash \"$NODE_COMMAND_DIR/postprocess_eval.sh\"",
      "env": {
        "POSTPROCESS_EVAL_COMMAND": "bash \"$AUTO_POLLEN_ROOT/batch_eval_pollen.sh\"",
        "POSTPROCESS_EVAL_CWD": "/g7/anxq/Zhangjt/workspace/auto-pollen"
      },
      "slurm": {
        "walltime": "04:00:00"
      }
    },
    "product_extract": {
      "command": "bash \"$NODE_COMMAND_DIR/product_extract.sh\"",
      "slurm": {
        "walltime": "01:00:00"
      }
    },
    "package_products": {
      "command": "bash \"$NODE_COMMAND_DIR/package_products.sh\"",
      "slurm": {
        "walltime": "00:20:00"
      }
    }
  }
}
