# SManager local backend configuration.
# The local backend uses MySQL only. SQLite files are no longer supported.

PROJECT_NAME="China Pollen Forecast System"
VERSION="1.0.0"
API_V1_STR="/api/v1"

DATABASE_URL="mysql+pymysql://smanager:smanager123@127.0.0.1:3306/smanager?charset=utf8mb4"

ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
SECRET_KEY="change-me-to-a-long-random-secret"
AUTH_TOKEN_EXPIRE_MINUTES=720

# Planned private tunnel/server API integration.
# smanager-server on CentOS (direct LAN or SSH tunnel).
SERVER_API_BASE_URL="http://10.40.140.17:8765"
SERVER_API_TOKEN=""
# 普通 API 请求超时（秒）；tick 强制提交可能跑很久，见 SERVER_TICK_TIMEOUT
SERVER_REQUEST_TIMEOUT=30
SERVER_TICK_TIMEOUT=3600
TUNNEL_HEALTH_URL=""

# Server-side FNL locations are metadata only from the local backend view.
SERVER_FNL_ROOTS=""
SERVER_FNL_REPAIR_ROOT=""

# Local FNL repair worker configuration.
FNL_DOWNLOAD_COMMAND=""
FNL_GDEX_BASE_URL="https://osdf-director.osg-htc.org/ncar/gdex/d083002/grib2"
FNL_DOWNLOAD_MAX_RETRIES=5
FNL_DOWNLOAD_RETRY_DELAY=10
FNL_UPLOAD_TIMEOUT=600
LOCAL_FNL_CACHE_DIR="runtime/fnl"
FNL_MIN_MB=5

# Local runtime storage.
LOCAL_PRODUCTS_DIR="runtime/products"
LOCAL_LOGS_DIR="runtime/logs"
LOCAL_MANIFESTS_DIR="runtime/manifests"
LOCAL_CACHE_DIR="runtime/cache"
PRODUCT_INLINE_MAX_MB=20

NOTIFICATION_WEBHOOK_URL=""
NOTIFICATION_WEBHOOK_TIMEOUT=10

STORAGE_RETENTION_DAYS=30
STORAGE_MAX_GB=50

# 后台自动修补 FNL：>0 时 backend 每隔 N 秒拉取 pending repair 并下载上传；0 表示仅手动触发
FNL_REPAIR_POLL_INTERVAL_SECONDS=0
