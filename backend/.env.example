# SManager local backend configuration.
# The local backend uses MySQL only. SQLite files are no longer supported.

PROJECT_NAME="China Pollen Forecast System"
VERSION="1.0.0"
API_V1_STR="/api/v1"

DATABASE_URL="mysql+pymysql://smanager:12345678@127.0.0.1:3306/smanager?charset=utf8mb4"

ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
SECRET_KEY="change-me-to-a-long-random-secret"
AUTH_TOKEN_EXPIRE_MINUTES=720

# Planned private tunnel/server API integration.
SERVER_API_BASE_URL=""
SERVER_API_TOKEN=""
TUNNEL_HEALTH_URL=""

# Server-side FNL locations are metadata only from the local backend view.
SERVER_FNL_ROOTS=""
SERVER_FNL_REPAIR_ROOT=""

# Local FNL repair worker configuration.
FNL_DOWNLOAD_COMMAND=""
LOCAL_FNL_CACHE_DIR="runtime/fnl"
FNL_MIN_MB=5

# Local runtime storage.
LOCAL_PRODUCTS_DIR="runtime/products"
LOCAL_LOGS_DIR="runtime/logs"
LOCAL_MANIFESTS_DIR="runtime/manifests"
LOCAL_CACHE_DIR="runtime/cache"
PRODUCT_INLINE_MAX_MB=20

NOTIFICATION_WEBHOOK_URL=""
NOTIFICATION_WEBHOOK_TIMEOUT=10

STORAGE_RETENTION_DAYS=30
STORAGE_MAX_GB=50
