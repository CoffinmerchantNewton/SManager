# SManager jumpbox backend configuration.
# Copy to backend/.env for local backend runs, or to .env at the repository root
# when starting uvicorn from the root directory.

PROJECT_NAME="China Pollen Forecast System"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Keep runtime database files out of Git.
DATABASE_URL="sqlite:///./runtime/db/pollen_forecast.sqlite"

ADMIN_PASSWORD="change-me"
SECRET_KEY="change-me-to-a-long-random-secret"

# Use local for development when flowctl runs on the same machine.
# Use the CentOS server hostname/IP for production jumpbox deployment.
SERVER_SSH_HOST="local"
SERVER_SSH_USER=""
SERVER_SSH_PORT=22
SERVER_SSH_TIMEOUT=60

# Server-side flowctl installation.
SERVER_FLOWCTL_PATH="./server/auto-pollen-flow/flowctl.py"
SERVER_FLOW_WORKDIR=""
SERVER_FLOW_ROOT="./runtime/server-flow"

# Colon-separated FNL roots on the server. The server verifies these first.
SERVER_FNL_ROOTS="./runtime/server-fnl"

# Upload root used only when server verification reports missing or bad FNL.
# Uploaded files are placed under <SERVER_FNL_UPLOAD_DIR>/<year>/<yyyymmdd>/.
SERVER_FNL_UPLOAD_DIR="./runtime/server-fnl"

# External command run on the jumpbox when FNL must be repaired.
# It receives FNL_VALID_TIME, FNL_FILE_NAME, and FNL_OUTPUT_PATH.
# Example:
# FNL_DOWNLOAD_COMMAND='python3 scripts/download_fnl.py --valid-time "$FNL_VALID_TIME" --output "$FNL_OUTPUT_PATH"'
# Local smoke test only:
# FNL_DOWNLOAD_COMMAND="python3 scripts/fake_fnl_download.py"
FNL_DOWNLOAD_COMMAND=""
JUMPBOX_FNL_CACHE_DIR="runtime/fnl"
FNL_MIN_MB=5
FNL_UPLOAD_METHOD="rsync"

# Synced product files are copied from the server to this jumpbox directory.
JUMPBOX_PRODUCTS_DIR="runtime/products"
JUMPBOX_LOGS_DIR="runtime/logs"
JUMPBOX_MANIFESTS_DIR="runtime/manifests"
JUMPBOX_CACHE_DIR="runtime/cache"
PRODUCT_SYNC_METHOD="rsync"
